<idea-plugin>
    <id>com.seventhlayer.kokedera</id>
    <name>Kokedera - Moss Temple Theme</name>
    <vendor email="office@7thlayer.ventures" url="https://kokedera.style">lastdescent</vendor>

    <description><![CDATA[
    <h2>Kokedera - Moss Temple Theme</h2>
    <p>Moss-temple color themes — nine variants across the day, the seasons, and the weather of one garden.</p>

    <h3>Philosophy</h3>
    <p>Rooted in restraint — beauty in imperfection, transience, and the incomplete.
    No color shouts or demands attention. A quiet space where code can breathe.</p>

    <h3>Color Metaphors</h3>
    <ul>
        <li><b>Editor background</b> — Deep shade beneath ancient trees</li>
        <li><b>Keywords</b> — Sunlight catching the brightest moss</li>
        <li><b>Strings</b> — Warm amber of paper lanterns at dusk</li>
        <li><b>Comments</b> — Weathered stone inscriptions softened by time</li>
        <li><b>Types</b> — Dark green cedars standing tall</li>
        <li><b>Functions</b> — Fresh bamboo swaying in a gentle breeze</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="com.seventhlayer.kokedera.morning"
                       path="/themes/kokedera-morning.theme.json"/>
        <bundledColorScheme id="Kokedera Morning" path="/themes/KokederaMorning"/>
        <themeProvider id="com.seventhlayer.kokedera.dusk"
                       path="/themes/kokedera-dusk.theme.json"/>
        <bundledColorScheme id="Kokedera Dusk" path="/themes/KokederaDusk"/>
        <themeProvider id="com.seventhlayer.kokedera.night"
                       path="/themes/kokedera-night.theme.json"/>
        <bundledColorScheme id="Kokedera Night" path="/themes/KokederaNight"/>
        <themeProvider id="com.seventhlayer.kokedera.spring"
                       path="/themes/kokedera-spring.theme.json"/>
        <bundledColorScheme id="Kokedera Spring" path="/themes/KokederaSpring"/>
        <themeProvider id="com.seventhlayer.kokedera.summer"
                       path="/themes/kokedera-summer.theme.json"/>
        <bundledColorScheme id="Kokedera Summer" path="/themes/KokederaSummer"/>
        <themeProvider id="com.seventhlayer.kokedera.autumn"
                       path="/themes/kokedera-autumn.theme.json"/>
        <bundledColorScheme id="Kokedera Autumn" path="/themes/KokederaAutumn"/>
        <themeProvider id="com.seventhlayer.kokedera.winter"
                       path="/themes/kokedera-winter.theme.json"/>
        <bundledColorScheme id="Kokedera Winter" path="/themes/KokederaWinter"/>
        <themeProvider id="com.seventhlayer.kokedera.rain"
                       path="/themes/kokedera-rain.theme.json"/>
        <bundledColorScheme id="Kokedera Rain" path="/themes/KokederaRain"/>
        <themeProvider id="com.seventhlayer.kokedera.mist"
                       path="/themes/kokedera-mist.theme.json"/>
        <bundledColorScheme id="Kokedera Mist" path="/themes/KokederaMist"/>
    </extensions>
</idea-plugin>
